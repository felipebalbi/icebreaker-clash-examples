# iCEbreaker pin constraints for the BlinkyWithReset variant
# (Lattice iCE40 UP5K, sg48 package).
#
# Same as icebreaker.pcf, plus the user button as an active-low reset. Port
# names must match the `topEntity` named ports in src/BlinkyWithReset.hs
# (`clk`, `reset`, `led`).

# 12 MHz oscillator
set_io clk 35
set_frequency clk 12

# Green user LED
set_io led 11

# User button (active-low reset)
set_io reset 10
