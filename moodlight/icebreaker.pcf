# iCEbreaker pin constraints (Lattice iCE40 UP5K, sg48 package).
#
# Port names must match MoodLight.topEntity, which is what yosys synthesises.
# There is no wrapper module: the SB_RGBA_DRV instance is a Clash blackbox from
# ice40-prim, so the Clash top entity is also the synthesis top.

# 12 MHz oscillator
set_io clk 35
set_frequency clk 12

# User button, active low (idles high through a pull-up)
set_io btn 10

# RGB LED. These three pins are the SB_RGBA_DRV hard block's constant-current
# sinks. They can be driven as ordinary open-drain I/O -- the macro is not an
# access gate -- but the iCEbreaker wires the LED's cathodes straight to them
# with no series resistors, so the macro's regulated 2 mA is the only current
# limit there is. See the note in src/MoodLight.hs.
#
# Order matters and matches pack (r, g, b) in MoodLight.Pwm.pwmRGB:
# index 2 is red, index 1 green, index 0 blue.
set_io rgb[2] 39
set_io rgb[1] 40
set_io rgb[0] 41
