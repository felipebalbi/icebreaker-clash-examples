# iCEbreaker pin constraints (Lattice iCE40 UP5K, sg48 package).
#
# Port names must match the wrapper in verilog-support/icebreaker_top.v, which
# is what yosys synthesises -- not the Clash topEntity directly.

# 12 MHz oscillator
set_io clk 35
set_frequency clk 12

# User button, active low (idles high through a pull-up)
set_io btn 10

# RGB LED. These three pins are constant-current open-drain outputs driven by
# the UP5K's SB_RGBA_DRV hard block; they cannot be used as ordinary I/O.
#
# Order matters and matches pack (r, g, b) in MoodLight.Pwm.pwmRGB:
# index 2 is red, index 1 green, index 0 blue.
set_io rgb[2] 39
set_io rgb[1] 40
set_io rgb[0] 41
