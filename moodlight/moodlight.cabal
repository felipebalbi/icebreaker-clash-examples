cabal-version:       2.4
name:                moodlight
version:             0.1
synopsis:            Gamma-corrected RGB mood light for the iCEbreaker
license:             MIT
license-file:        LICENSE
author:              Felipe Balbi <felipe@balbi.sh>
copyright:           2026 Felipe Balbi

-- The common-options block is adopted from the upstream clash-starters
-- `orangecrab` project, via blinky. The ghc-options in particular are
-- load-bearing for Clash -- don't trim them without reason.
common common-options
  default-extensions:
    BangPatterns
    BinaryLiterals
    ConstraintKinds
    DataKinds
    DefaultSignatures
    DeriveAnyClass
    DeriveDataTypeable
    DeriveFoldable
    DeriveFunctor
    DeriveGeneric
    DeriveLift
    DeriveTraversable
    DerivingStrategies
    FlexibleContexts
    InstanceSigs
    KindSignatures
    LambdaCase
    NamedFieldPuns
    NoStarIsType
    PolyKinds
    RankNTypes
    RecordWildCards
    ScopedTypeVariables
    StandaloneDeriving
    TupleSections
    TypeApplications
    TypeFamilies
    TypeOperators
    ViewPatterns
    TemplateHaskell
    QuasiQuotes
    NoImplicitPrelude
  ghc-options:
    -Wall -Wcompat
    -haddock
    -fplugin GHC.TypeLits.Extra.Solver
    -fplugin GHC.TypeLits.Normalise
    -fplugin GHC.TypeLits.KnownNat.Solver
    -fexpose-all-unfoldings
    -fno-worker-wrapper
    -fno-unbox-small-strict-fields
    -fno-unbox-strict-fields
  build-depends:
    base,
    Cabal,
    clash-prelude >= 1.10.0 && < 1.12,
    ghc-typelits-natnormalise,
    ghc-typelits-extra,
    ghc-typelits-knownnat,
    -- Control.Monad.State.Strict, for the mealyS state-monad Mealy machines.
    transformers

library
  import: common-options
  hs-source-dirs: src
  exposed-modules:
    MoodLight
    MoodLight.Domain
    MoodLight.Gamma
    MoodLight.Mode
    MoodLight.Pwm
  default-language: Haskell2010

-- Generate Verilog with:  cabal run clash -- MoodLight --verilog
executable clash
  main-is: bin/Clash.hs
  default-language: Haskell2010
  Build-Depends: base, clash-ghc, moodlight
  ghc-options: "-with-rtsopts=-K512M -H -I5 -T"
  if !os(Windows)
    ghc-options: -dynamic

executable clashi
  main-is: bin/Clashi.hs
  default-language: Haskell2010
  ghc-options: "-with-rtsopts=-K512M -H -I5 -T"
  if !os(Windows)
    ghc-options: -dynamic
  build-depends: base, clash-ghc, moodlight

test-suite test-library
  import: common-options
  default-language: Haskell2010
  hs-source-dirs: tests
  type: exitcode-stdio-1.0
  ghc-options: -threaded
  main-is: unittests.hs
  other-modules:
    Tests.Gamma
    Tests.Mode
    Tests.Phase
    Tests.Pwm
  build-depends:
    moodlight,
    tasty >= 1.2 && < 1.6,
    tasty-hunit
