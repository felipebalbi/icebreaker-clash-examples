-- Pin the Clash 1.10.0 toolchain on GHC 9.10.3, matching the sibling blinky
-- example. cabal.project.freeze locks the entire transitive graph.

packages: .

with-compiler: ghc-9.10.3

-- The `clash` executable runs GHC on the moodlight sources, whose -fplugin
-- flags must resolve GHC.TypeLits.* solver modules. Writing a .ghc.environment
-- file makes cabal's whole package closure visible to that nested GHC session.
write-ghc-environment-files: always

index-state: 2026-07-04T16:13:10Z

tests: True

-- ice40-prim supplies the SB_RGBA_DRV blackbox (Ice40.Rgb). Its upper bounds
-- predate GHC 9.10 and Clash 1.10, but nothing in it actually breaks: the
-- library builds clean and the blackbox generates correct Verilog. allow-newer
-- is the whole fix, and the bound bump is worth sending upstream.
allow-newer:
  ice40-prim:base,
  ice40-prim:clash-prelude

constraints:
  ice40-prim ==0.3.1.4,
  clash-ghc ==1.10.0,
  clash-lib ==1.10.0,
  clash-prelude ==1.10.0,
  ghc-typelits-extra ==0.5.3,
  ghc-typelits-knownnat ==0.8.3,
  ghc-typelits-natnormalise ==0.9.5,
  ghc-tcplugin-api ==0.18.2.1
